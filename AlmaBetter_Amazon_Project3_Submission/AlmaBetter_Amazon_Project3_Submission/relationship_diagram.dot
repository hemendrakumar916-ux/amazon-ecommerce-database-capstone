  "seller_listings" -> "sellers" [xlabel="seller_id", fontsize=8, color="#94a3b8"];
  "orders" -> "addresses" [xlabel="shipping_address_id", fontsize=8, color="#94a3b8"];
  "orders" -> "customers" [xlabel="customer_id", fontsize=8, color="#94a3b8"];
  "order_items" -> "seller_listings" [xlabel="listing_id", fontsize=8, color="#94a3b8"];
  "order_items" -> "orders" [xlabel="order_id", fontsize=8, color="#94a3b8"];
  "categories" -> "categories" [xlabel="parent_category_id", fontsize=8, color="#94a3b8"];
  "payments" -> "orders" [xlabel="order_id", fontsize=8, color="#94a3b8"];
  "products" -> "categories" [xlabel="category_id", fontsize=8, color="#94a3b8"];
  "refunds" -> "payments" [xlabel="payment_id", fontsize=8, color="#94a3b8"];
  "refunds" -> "returns" [xlabel="return_id", fontsize=8, color="#94a3b8"];
