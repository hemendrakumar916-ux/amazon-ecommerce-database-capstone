digraph AmazonERD {
  graph [rankdir=LR, splines=polyline, nodesep=0.35, ranksep=1.2, bgcolor="white", fontname="Arial", label="AMAZON-INSPIRED MARKETPLACE DATABASE | 17 TABLES | 22 FOREIGN KEYS", labelloc=t, fontsize=19, pad=0.3];
  node [shape=plain, fontname="Arial"];
  edge [color="#718096", arrowsize=0.65, penwidth=1.1];
  subgraph cluster_0 {
   label="Catalog"; color="#e2e8f0"; style="rounded"; penwidth=1.3;
   "categories" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">categories</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">category_id PK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">category_name</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">description</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">parent_category_id FK</FONT></TD></TR></TABLE>>];
   "products" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">products</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">product_id PK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">product_name</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">description</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">category_id FK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">brand</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">product_status</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR></TABLE>>];
   "sellers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">sellers</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">seller_id PK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">seller_name</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">email</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">phone</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">business_city</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">seller_status</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR></TABLE>>];
   "seller_listings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">seller_listings</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">listing_id PK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">product_id FK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">seller_id FK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">price</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">listing_status</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR></TABLE>>];
   "inventory" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">inventory</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">inventory_id PK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">listing_id FK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">stock_quantity</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">updated_at</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_1 {
   label="Customer & Cart"; color="#e2e8f0"; style="rounded"; penwidth=1.3;
   "customers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">customers</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">customer_id PK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">full_name</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">email</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">phone</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR></TABLE>>];
   "addresses" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">addresses</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">address_id PK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">customer_id FK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">address_line</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">city</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">state</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">postal_code</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">country</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">is_default</FONT></TD></TR></TABLE>>];
   "carts" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">carts</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">cart_id PK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">customer_id FK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">updated_at</FONT></TD></TR></TABLE>>];
   "cart_items" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">cart_items</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">cart_item_id PK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">cart_id FK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">listing_id FK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">quantity</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">added_at</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_2 {
   label="Order & Fulfilment"; color="#e2e8f0"; style="rounded"; penwidth=1.3;
   "orders" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">orders</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">order_id PK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">customer_id FK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">shipping_address_id FK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">order_date</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">total_amount</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">order_status</FONT></TD></TR></TABLE>>];
   "order_items" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">order_items</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">order_item_id PK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">order_id FK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">listing_id FK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">quantity</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">unit_price</FONT></TD></TR></TABLE>>];
   "payments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">payments</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">payment_id PK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">order_id FK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">payment_method</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">payment_amount</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">payment_status</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">transaction_reference</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">payment_date</FONT></TD></TR></TABLE>>];
   "shipments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">shipments</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">shipment_id PK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">order_id FK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">seller_id FK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">courier_name</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">tracking_number</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">shipment_status</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">shipped_at</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">delivered_at</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR></TABLE>>];
   "tracking_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">tracking_events</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">tracking_event_id PK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">shipment_id FK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">event_status</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">location</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">event_description</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">event_time</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_3 {
   label="Customer Feedback & Returns"; color="#e2e8f0"; style="rounded"; penwidth=1.3;
   "reviews" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">reviews</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">review_id PK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">customer_id FK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">product_id FK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">rating</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">review_title</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">review_text</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR></TABLE>>];
   "returns" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">returns</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">return_id PK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">order_item_id FK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">return_quantity</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">return_reason</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">return_status</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">requested_at</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">approved_at</FONT></TD></TR></TABLE>>];
   "refunds" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD BGCOLOR="#eff6ff"><B><FONT POINT-SIZE="12">refunds</FONT></B></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">refund_id PK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">return_id FK</FONT></TD></TR><TR><TD BGCOLOR="#f7fafc" ALIGN="LEFT"><FONT POINT-SIZE="10">payment_id FK</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">refund_amount</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">refund_status</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">refund_reference</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="10">processed_at</FONT></TD></TR></TABLE>>];
  }
  "carts" -> "customers" [xlabel="customer_id", fontsize=8, color="#94a3b8"];
  "cart_items" -> "carts" [xlabel="cart_id", fontsize=8, color="#94a3b8"];
  "cart_items" -> "seller_listings" [xlabel="listing_id", fontsize=8, color="#94a3b8"];
  "addresses" -> "customers" [xlabel="customer_id", fontsize=8, color="#94a3b8"];
  "inventory" -> "seller_listings" [xlabel="listing_id", fontsize=8, color="#94a3b8"];
