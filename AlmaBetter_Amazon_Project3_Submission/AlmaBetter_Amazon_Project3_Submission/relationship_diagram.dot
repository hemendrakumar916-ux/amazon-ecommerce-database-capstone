  "reviews" -> "customers" [xlabel="customer_id", fontsize=8, color="#94a3b8"];
  "reviews" -> "products" [xlabel="product_id", fontsize=8, color="#94a3b8"];
  "shipments" -> "orders" [xlabel="order_id", fontsize=8, color="#94a3b8"];
  "shipments" -> "sellers" [xlabel="seller_id", fontsize=8, color="#94a3b8"];
